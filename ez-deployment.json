{
  "schemaVersion": 2,
  "services": {
    "plugin": {
      "buildTarget": "runtime",
      "volumes": {
        "profile": "/state",
        "ipc": "/ipc"
      },
      "healthcheck": [
        "node",
        "/app/src/cli.mjs",
        "--version"
      ],
      "memoryMiB": 128
    },
    "broker": {
      "buildTarget": "broker",
      "volumes": {
        "broker": "/state",
        "ipc": "/ipc"
      },
      "command": [
        "node",
        "src/broker.mjs",
        "/state/broker.secret.json",
        "--socket"
      ],
      "healthcheck": [
        "node",
        "-e",
        "require('node:fs').statSync('/ipc/composio.sock')"
      ],
      "memoryMiB": 256
    }
  },
  "commands": {
    "composio": {
      "service": "plugin",
      "argv": [
        "node",
        "/app/src/cli.mjs"
      ]
    }
  }
}
